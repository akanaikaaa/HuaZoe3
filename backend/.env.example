PORT=4000
NODE_ENV=development
# Comma-separated list of allowed web origins (Android does not use CORS)
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never ship to web/Android.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=reports

# Local LLM without any API key: 'ollama' or 'mock'
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Gemini (only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MAX_UPLOAD_MB=15
JOB_CONCURRENCY=2
# Optional realtime layer (Socket.io). REST polling always works.
ENABLE_SOCKETIO=false

# Resend Email & Token Authentication
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=HealthTrack <onboarding@resend.dev>
APP_URL=http://localhost:5173
